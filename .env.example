# Copie ce fichier en ".env" (non versionné) et remplace la valeur par ta clé.
# Clé gratuite, sans carte bancaire, sur https://console.groq.com
GROQ_API_KEY=gsk_remplace_par_ta_cle

# Clé d'API protégeant l'endpoint /judge de la façade HTTP (invente une valeur
# longue et aléatoire). Requise dès qu'on lance l'API web.
API_KEY=change_moi_pour_une_valeur_longue_et_aleatoire

# Optionnel. Par défaut : un fichier SQLite local (sqlite:///./eval_runs.db).
# En production, une URL PostgreSQL, ex : postgresql://user:pass@host:5432/dbname
# DATABASE_URL=
